<!-- HEADER -->
<header class="site-header">
  <div class="nav">
    <a href="/" class="logo">
      <span class="dot"></span>
      tuveuxun.expert
    </a>
    <ul class="nav-links">
      <li><a href="/">Accueil</a></li>
      <li><a href="/tarifs.html" class="active">Tarifs</a></li>
      <li><a href="/parcours.html">Parcours</a></li>
    </ul>
    <a href="#rdv" class="nav-cta">RDV decouverte</a>
  </div>
</header>

<!-- HERO -->
<section class="hero-tarifs">
  <div class="container">
    <div class="hero-eyebrow reveal">Forfaits publics · TTC ferme · Devis 48h</div>
    <h1 class="reveal">L'IA, calibree<br><span class="holo">pour votre metier.</span></h1>
    <p class="tagline reveal">
      Forfaits packages pour <strong>PME, mairies, associations</strong>.
      Pas d'abonnement piege, pas de frais cache. <strong>Vous savez ce que vous payez.</strong>
    </p>
  </div>
</section>

<!-- FORFAITS -->
<section class="forfaits">
  <div class="container">
    <div class="section-label reveal">3 forfaits packages</div>
    <h2 class="section-title reveal">Choisissez selon <em>votre maturite IA</em>.</h2>

    <div class="forfaits-grid reveal-stagger">

      <article class="forfait-card card-mint">
        <div class="forfait-icon">🔍</div>
        <h3 class="forfait-name">Audit IA</h3>
        <p class="forfait-target">TPE, PME, association curieuse mais hesitante. Pour savoir si l'IA peut reellement aider.</p>
        <div class="forfait-price">
          <span class="amount">1 500</span>
          <span class="currency">€ HT</span>
        </div>
        <div class="forfait-duration">forfait · 3 jours</div>
        <ul class="forfait-features">
          <li>2h interview equipe + immersion processus</li>
          <li>Cartographie 5 a 10 taches automatisables</li>
          <li>ROI estime par tache (heures/mois)</li>
          <li>Recommandations priorisees</li>
          <li>Demo IA live sur 1 cas concret</li>
        </ul>
        <a href="#rdv" class="forfait-cta">Demander un devis</a>
      </article>

      <article class="forfait-card card-peach featured">
        <div class="forfait-icon">⚡</div>
        <h3 class="forfait-name">Agent metier</h3>
        <p class="forfait-target">Structure avec 1 process clair a automatiser : reponses mails, traitement docs, generation rapports.</p>
        <div class="forfait-price">
          <span class="amount">4 500</span>
          <span class="currency">€ HT</span>
        </div>
        <div class="forfait-duration">forfait · 7 jours</div>
        <ul class="forfait-features">
          <li>Conception et deploiement agent IA</li>
          <li>Connexion outils existants (mail, docs, CRM)</li>
          <li>Tests sur cas reels + ajustements</li>
          <li>2h prise en main avec votre equipe</li>
          <li>30 jours de support inclus</li>
        </ul>
        <a href="#rdv" class="forfait-cta">Reserver ce forfait</a>
      </article>

      <article class="forfait-card card-lavender">
        <div class="forfait-icon">🛡️</div>
        <h3 class="forfait-name">Agent souverain</h3>
        <p class="forfait-target">Mairies, cabinets juridiques/sante, donnees sensibles. <strong>Vos donnees ne sortent pas de votre serveur.</strong></p>
        <div class="forfait-price">
          <span class="amount">8 500</span>
          <span class="currency">€ HT</span>
        </div>
        <div class="forfait-duration">forfait · 12 jours</div>
        <ul class="forfait-features">
          <li>Tout du forfait Agent metier</li>
          <li>LLM local on-premise (Llama, Mistral)</li>
          <li>Conformite RGPD renforcee</li>
          <li>Aucune donnee envoyee dans le cloud</li>
          <li>60 jours de support inclus</li>
        </ul>
        <a href="#rdv" class="forfait-cta">Demander un devis</a>
      </article>

    </div>
  </div>
</section>

<!-- SUR MESURE -->
<section class="sur-mesure">
  <div class="container">
    <div class="sur-mesure-card reveal">
      <div class="corner-deco">✦</div>
      <div>
        <div class="section-label" style="margin-bottom: 14px;">Besoin specifique</div>
        <h3>Sur mesure, devis ferme.</h3>
        <p>Multi-process chaines, refonte complete, integration profonde, formation interne, direction artistique. Cadrage commun en RDV puis devis ferme sous 48h.</p>
      </div>
      <div class="sur-mesure-price">
        <div class="label">A partir de</div>
        <div class="range">900–1 200</div>
        <div class="unit">€ HT / jour</div>
      </div>
    </div>
  </div>
</section>

<!-- MODULES -->
<section class="modules">
  <div class="container">
    <div class="section-label reveal">Modules a la carte</div>
    <h2 class="section-title reveal">Prestations <em>complementaires</em>.</h2>
    <div class="modules-grid reveal-stagger">
      <div class="module-row">
        <div class="module-info">
          <h4>Pipeline IA generative communication</h4>
          <p>Visuels reseaux sociaux, supports print, montages video automatises</p>
        </div>
        <div class="module-price">4 400 €</div>
      </div>
      <div class="module-row">
        <div class="module-info">
          <h4>Chatbot citoyen / adherent</h4>
          <p>Mairies, associations · FAQ multilingue · base docs</p>
        </div>
        <div class="module-price">2 700 €</div>
      </div>
      <div class="module-row">
        <div class="module-info">
          <h4>Formation IA equipe (1 journee)</h4>
          <p>Jusqu'a 12 personnes · programme custom · hands-on</p>
        </div>
        <div class="module-price">1 200 € / j</div>
      </div>
      <div class="module-row">
        <div class="module-info">
