
# ── Auto-evolution (decision 02/09/2026 : MAJ proposee /4 mois a 120 EUR, jamais d'abonnement)
# Secret partage entre la publication (ce serveur) et les produits livres. 32+ caracteres. JAMAIS commite.
EVOLUTION_SECRET=
# Identite de CE produit livre (chez un client : mairiebot, docusweep, ...)
EVOLUTION_PRODUCT=mairiebot
# Ou ce produit lit son manifeste. Chez un client : https://api.tuveuxun.expert/evolution/manifest/mairiebot
EVOLUTION_MANIFEST_URL=

# ── Emails des leads (26/09/2026) : /lead envoie un accuse de reception au prospect + une notif a Naim.
# SMTP via relais Brevo (memes noms de variables que le reste de l'ecosysteme). Vide = aucun envoi,
# le lead reste capte en SQLite (rien ne casse). Port 465 = SSL ; sinon 587 = STARTTLS.
# EMAIL_SERVER_PASSWORD = cle SMTP generee dans Brevo (Parametres > SMTP & API > cles SMTP), PAS le mot de passe.
# EMAIL_FROM = expediteur VALIDE dans Brevo (ex. contact@tuveuxun.expert une fois le domaine authentifie).
EMAIL_SERVER_HOST=smtp-relay.brevo.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=contact@tuveuxun.expert
# Ta boite qui recoit la notif de chaque lead (alias Proton tv1e -> ta boite). Vide = pas de notif.
LEAD_NOTIFY_EMAIL=
